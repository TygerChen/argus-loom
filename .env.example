# ─────────────────────────────────────────────
# Argus-Loom 生产环境变量示例
# 复制为 .env 后填写真实值；生产环境严禁把密钥写进代码仓库。
# ─────────────────────────────────────────────

# LLM（Agnes/DashScope 等 OpenAI 兼容接口）
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_BASE_URL=https://api.agnes-ai.cn
LLM_CHAT_MODEL=agnes-3.0-flash
EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_API_KEY=

# PostgreSQL（pgvector）
DB_URL=jdbc:postgresql://postgres:5432/argus_rag
DB_HOST=localhost
DB_PORT=5432
DB_NAME=argus_rag
DB_USER=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=argus_rag

# MinIO 对象存储
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=argus-rag-documents
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# Elasticsearch
ES_HOST=elasticsearch
ES_PORT=9200
ES_SCHEME=http

# 认证与安全
ARGUS_RAG_JWT_SECRET=at-least-32-character-production-secret
SERVER_PORT=8080

# 后台默认管理员（首次启动创建）
ARGUS_RAG_DEV_ADMIN_USERNAME=
ARGUS_RAG_DEV_ADMIN_EMAIL=
ARGUS_RAG_DEV_ADMIN_DISPLAY_NAME=
ARGUS_RAG_DEV_ADMIN_PASSWORD=
ARGUS_RAG_DEV_ADMIN_USER_CODE=

# 外部搜索（可选）
YOUCOM_SEARCH_ENABLED=false
YOUCOM_API_KEY=
